
#!/bin/bash

# Author: Nivedita Kalra
# Purpose: Display system information report

echo "======================================"
echo "       SYSTEM INFORMATION REPORT"
echo "======================================"

echo "Name: Nivedita Kalra"
echo "Roll Number: YOUR_ROLL_NUMBER"
echo "Date: $(date)"

echo ""
echo "CPU INFORMATION"
echo "--------------------------------------"

CPU_MODEL=$(lscpu | grep "Model name" | head -1 | cut -d ':' -f2)
CPU_CORES=$(nproc)

echo "CPU Model: $CPU_MODEL"
echo "Number of Cores: $CPU_CORES"

echo ""
echo "MEMORY INFORMATION"
echo "--------------------------------------"

free -h | awk 'NR==2 {
    print "Total Memory: " $2
    print "Used Memory: " $3
}'

echo ""
echo "TOP 3 PROCESSES BY CPU USAGE"
echo "--------------------------------------"

ps -eo pid,comm,%cpu --sort=-%cpu | head -n 4

echo ""
echo "======================================"
echo "Report generated successfully."
echo "======================================"


